# SMTP settings for the "Kontakti" and "Sadarbība" forms (src/lib/mailer.js).
# Copy this file to .env.local and fill in real values — .env.local is
# git-ignored, so it never gets committed.

# SMTP server host, e.g. smtp.gmail.com or your hosting provider's SMTP host.
SMTP_HOST=

# SMTP port — usually 587 (STARTTLS) or 465 (implicit TLS).
SMTP_PORT=587

# Set to "true" only if using port 465. Leave unset/"false" for port 587.
SMTP_SECURE=false

# SMTP login credentials (often the mailbox's own email + password/app password).
SMTP_USER=
SMTP_PASS=

# Where form submissions are delivered. Defaults to SMTP_USER if unset.
CONTACT_TO_EMAIL=info@tnbaltic.lt

# "From" address on outgoing mail. Defaults to SMTP_USER if unset — many SMTP
# providers reject a "From" address that isn't the authenticated mailbox.
CONTACT_FROM_EMAIL=
