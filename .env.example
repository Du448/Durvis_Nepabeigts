# SMTP settings for the "Kontakti" and "Sadarbība" forms (src/lib/mailer.js).
# Copy this file to .env.local and fill in real values — .env.local is
# git-ignored, so it never gets committed.

# SMTP server host, e.g. smtp.gmail.com or your hosting provider's SMTP host.
SMTP_HOST=

# SMTP port — usually 587 (STARTTLS) or 465 (implicit TLS).
SMTP_PORT=587

# Set to "true" only if using port 465. Leave unset/"false" for port 587.
SMTP_SECURE=false

# SMTP login credentials (often the mailbox's own email + password/app password).
SMTP_USER=
SMTP_PASS=

# Where form submissions are delivered. Defaults to SMTP_USER if unset.
CONTACT_TO_EMAIL=info@tnbaltic.lt

# "From" address on outgoing mail. Defaults to SMTP_USER if unset — many SMTP
# providers reject a "From" address that isn't the authenticated mailbox.
CONTACT_FROM_EMAIL=

# Only set to "true" on a dev machine whose antivirus/network intercepts TLS
# with its own certificate (e.g. AVG), which Node won't otherwise trust.
# Never set this in production — it disables SMTP certificate verification.
SMTP_ALLOW_INSECURE_TLS=false

# --- Price panel (/admin) ---
# Password the shop uses to log in to /admin.
ADMIN_PASSWORD=
# Long random string (32+ characters) that signs the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Read-write token of the Vercel Blob store that holds the edited prices.
# Added automatically when a Blob store is connected to the Vercel project.
BLOB_READ_WRITE_TOKEN=
# Set to "public" only if the Blob store was created as public (default: private).
BLOB_ACCESS=
