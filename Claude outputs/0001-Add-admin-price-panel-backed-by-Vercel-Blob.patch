diff --git a/.env.example b/.env.example
index e32b2ce..9452ea7 100644
--- a/.env.example
+++ b/.env.example
@@ -26,3 +26,15 @@ CONTACT_FROM_EMAIL=
 # with its own certificate (e.g. AVG), which Node won't otherwise trust.
 # Never set this in production — it disables SMTP certificate verification.
 SMTP_ALLOW_INSECURE_TLS=false
+
+# --- Price panel (/admin) ---
+# Password the shop uses to log in to /admin.
+ADMIN_PASSWORD=
+# Long random string (32+ characters) that signs the admin session cookie.
+# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
+ADMIN_SESSION_SECRET=
+# Read-write token of the Vercel Blob store that holds the edited prices.
+# Added automatically when a Blob store is connected to the Vercel project.
+BLOB_READ_WRITE_TOKEN=
+# Set to "public" only if the Blob store was created as public (default: private).
+BLOB_ACCESS=
